.air-tmp/

# Backup/scratch files
*.bck.yml

# Local settings contain tokens — never commit
.claude/settings.local.json

# Scheduled-task runtime lock — local only
.claude/scheduled_tasks.lock
.claude/agent-memory

# local docs
/docs/local

# Per-branch local todo / handoff scratch — not for shared history
/TODOS.md

# Branch review / analysis outputs — ephemeral, not for shared history
/outputs/
**/coverage.out

# Vue SPA build output — only dist/.gitkeep is committed so `//go:embed all:dist`
# (the all: prefix embeds dot-files) compiles without requiring a pnpm build first.
# Everything else under dist/ (index.html, assets/, icons, manifest, service worker)
# is a real `vite build` artifact and is ignored so build output never bloats or
# dirties the repo. The SPA is unservable until `task build:all` populates dist/.
server/frontend/dist/*
!server/frontend/dist/.gitkeep
server/coverage.out

# Playwright per-run output
test-results/
###> agent-context (transient working state) ###
# Per-session task plan, kept locally to avoid merge conflicts across branches.
/.agent-context/memory/todo.md
###< agent-context ###

# desktop shell build output
/desktop/desktop
/desktop/build/bin/
