node_modules/
/dist/
.worktrees/
package-lock.json
.superpowers/
*.log
.DS_Store
.env
.env.*
!.env.dist

# MCP config contains token placeholders — copy from .mcp.json.example
.mcp.json
!.mcp.json.example


# Agent skills (installed from skills-lock.json)
.claude/skills/
.agents/skills/
.claude/worktrees/

# Compiled single-binary (bun build --compile)
/dashboard

# Go compiled binaries
/server/serve
/serve
/bin/
.air-tmp/

# Backup/scratch files
*.bck.yml

# Local settings contain tokens — never commit
.claude/settings.local.json

# Scheduled-task runtime lock — local only
.claude/scheduled_tasks.lock

# local docs
/docs/local

# Per-branch local todo / handoff scratch — not for shared history
/TODOS.md

# Branch review / analysis outputs — ephemeral, not for shared history
/outputs/
**/coverage.out

# Vue SPA build output — the placeholder dist/index.html is committed so go:embed
# compiles without requiring a pnpm build first. Everything else under dist/ is a
# real `vite build` artifact (assets/, icons, manifest, service worker, etc.) and
# is ignored so build output never bloats or dirties the repo.
server/frontend/dist/*
!server/frontend/dist/index.html
server/coverage.out

# Playwright per-run output
test-results/
