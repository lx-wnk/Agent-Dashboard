# Agent Dashboard — environment variables
# Copy this file to .env and fill in values as needed.
# All DASHBOARD_* vars are read by the Go backend.
# All VITE_* vars are embedded at build time (or injected by Vite dev server).
#
# Minimal setup: no changes required — defaults work for local single-user use.

# ─── Server ──────────────────────────────────────────────────────────────────

# Bind address. Never change to 0.0.0.0 — dashboard reads sensitive Claude session data.
DASHBOARD_HOST=127.0.0.1

# HTTP port.
DASHBOARD_PORT=13120

# JWT signing secret (min 32 chars). If unset, an ephemeral secret is generated on each
# restart — sessions survive only until the next restart.
DASHBOARD_JWT_SECRET=

# ─── Authentication ───────────────────────────────────────────────────────────

# Auth mode.
#   none    — no login required (default; suitable for local single-user use)
#   plugin  — OAuth required; needs an auth_provider plugin (GitHub, Office365, etc.)
#   github  — deprecated alias for "plugin"
DASHBOARD_AUTH=none

# Directory for auth and route-extension plugins. Leave empty to disable plugin loading.
DASHBOARD_PLUGIN_DIR=

# Shared secret between the core server and an auth plugin (POST /api/auth/session).
# Required when using an auth plugin. Minimum 32 characters.
DASHBOARD_AUTH_PLUGIN_SECRET=

# ─── Database ─────────────────────────────────────────────────────────────────

# SQLite database path for the task pipeline.
DASHBOARD_DB_PATH=~/.claude/dashboard-tasks.db

# ─── Agent SSE ────────────────────────────────────────────────────────────────

# How often the backend broadcasts an agent snapshot to SSE subscribers (ms).
DASHBOARD_SSE_INTERVAL_MS=3000

# Extra Claude config directories to scan for session JSONL files.
# Comma-separated. Useful when using multiple Claude profiles (e.g. ~/.claude-personal,~/.claude-work).
DASHBOARD_CLAUDE_CONFIG_DIRS=

# ─── Hooks ────────────────────────────────────────────────────────────────────

# Shared bearer token for POST /api/hooks/event. Recommended when the hooks script
# runs outside localhost. Leave empty to allow any loopback caller.
DASHBOARD_HOOKS_SECRET=

# Debounce window before SSE rescan after a hook event (ms).
DASHBOARD_HOOKS_DEBOUNCE_MS=100

# ─── Agent spawning ───────────────────────────────────────────────────────────

# Max user-initiated agent spawns per rate-limit window.
DASHBOARD_SPAWN_RATE_LIMIT=5

# Rate-limit window duration (ms).
DASHBOARD_SPAWN_RATE_WINDOW_MS=60000

# Allow spawned pipeline agents to run git push. Off by default.
# Per-task override: set metadata.allowGitPush=true on the task.
DASHBOARD_ALLOW_GIT_PUSH=false

# Allow POST /api/tasks/:id/git-action with action=pull (git pull --ff-only on task worktree).
DASHBOARD_ALLOW_GIT_PULL=false

# Root directory for per-task git worktrees. Defaults to a sibling of the repo root.
DASHBOARD_WORKTREE_ROOT=

# ─── LLM adapter (optional) ──────────────────────────────────────────────────

# Custom spawner executable that implements the LLMSpawner contract.
# Only needed when using the "custom" adapter.
DASHBOARD_SPAWN_COMMAND=

# ─── Frontend ─────────────────────────────────────────────────────────────────

# GitHub organisation name shown on the login page (optional, display only).
VITE_GITHUB_ORG=

# ─── Internal — DO NOT SET MANUALLY ──────────────────────────────────────────
# These are injected automatically by the dashboard into spawned pipeline agents.
#
# DASHBOARD_STAGE_RUN_ID   — identifies the current stage run
# DASHBOARD_TASK_ID        — identifies the current task
# DASHBOARD_MCP_TOKEN      — bearer token for the MCP callback endpoint
# DASHBOARD_MCP_URL        — URL of the MCP callback endpoint
