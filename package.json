{
  "name": "claude-agent-overview",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file=.env --import tsx/esm server/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit",
    "fix": "eslint . --fix && vue-tsc --noEmit && vitest run"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "express": "^5.1.0",
    "vue": "^3.5.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.1.0",
    "@playwright/test": "^1.59.1",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.2",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.2.0",
    "jsdom": "^29.0.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^4.1.3",
    "vue-tsc": "^3.2.6"
  }
}
