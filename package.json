{
  "name": "claude-agent-overview",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "Real-time monitoring and control dashboard for locally running Claude Code agents",
  "author": "Alexander Wink",
  "license": "MIT",
  "homepage": "https://github.com/lx-wnk/Agent-Dashboard",
  "repository": {
    "type": "git",
    "url": "https://github.com/lx-wnk/Agent-Dashboard.git"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file=.env --import tsx/esm server/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit",
    "fix": "eslint . --fix && vue-tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.8.0",
    "consola": "^3.4.2",
    "dompurify": "^3.3.3",
    "express": "^5.1.0",
    "marked": "^18.0.0",
    "nodemailer": "^8.0.5",
    "vue": "^3.5.13",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.1.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.2",
    "@types/nodemailer": "^8.0.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.2.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^4.1.3",
    "vue-tsc": "^3.2.6"
  }
}
